# 3end-bot model configuration. Copy to .env and fill in your own values.
# The bot calls any OpenAI-compatible /chat/completions endpoint.
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_API_KEY=your-api-key-here
USER_LLM_MODEL=gpt-4o-mini

# Server port for the standalone backend (web, desktop and mobile all call it).
PORT=8787

# Where team data and bot memory are stored (JSON + Markdown).
DATA_DIR=./data
